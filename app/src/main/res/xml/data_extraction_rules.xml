<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Android 12+ (API 31+) Data Extraction Hardening:
        Prevent user proxy credentials in nexora_profiles.db and sing-box runtime state
        from being extracted to cloud backups or unencrypted device transfers.
    -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="singbox" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="singbox" />
    </device-transfer>
</data-extraction-rules>
